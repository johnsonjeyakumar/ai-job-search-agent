# ============================================================
# Job Search & Application Agent — environment template
# Copy to .env and fill in REAL values locally. Never commit .env
# ============================================================

# --- Application ---
APP_NAME=Job Search & Application Agent
APP_VERSION=0.1.0
DEBUG=true

# --- Database (PostgreSQL) ---
# Driver scheme must be postgresql+psycopg (psycopg v3).
# Example: postgresql+psycopg://user:password@localhost:5432/job_agent
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/job_agent

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI provider (abstract layer) ---
# Options: mock (default, no external calls). Concrete providers added later.
AI_PROVIDER=mock
AI_MODEL=

# --- Job discovery (Apify) ---
# Leave APIFY_TOKEN empty to run discovery through the mock source with no
# external calls; set your Apify API token to enable real Actor runs.
APIFY_TOKEN=
# Apify Actor used by POST /jobs/search (default: Indeed jobs scraper).
APIFY_ACTOR_ID=schnellscrapers~indeed-jobs-scraper
APIFY_MAX_ITEMS=20
APIFY_RUN_TIMEOUT_SECS=300
APIFY_POLL_INTERVAL_SECS=5

# --- Local file storage (resolved under the project root) ---
UPLOAD_DIR=storage/resumes
MAX_UPLOAD_SIZE_MB=10